# Production (the classroom demo): DB kept warm (0.5 ACU min) so first questions are fast
DOMAIN_NAME=demo.awsteach.com
HOSTED_ZONE_NAME=awsteach.com
DB_MIN_CAPACITY=0.5
DB_MAX_CAPACITY=4
API_RATE_LIMIT=25
API_BURST_LIMIT=50
API_DAILY_QUOTA=20000
WAF_RATE_LIMIT=2000
LOG_RETENTION_DAYS=30
# Class Insights chatbot model (the Gas Ops chat model is chosen by Model Lab / AppConfig)
CHAT_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
ALERT_EMAIL=
SAML_METADATA_URL=
ALLOWED_CIDRS=
# Class Insights companion app (insights/)
INSIGHTS_DOMAIN=demo-insights.awsteach.com
