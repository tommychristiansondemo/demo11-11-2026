# Development: scales DB to zero when idle, generous rate limit, short log retention
DOMAIN_NAME=demo-dev.awsteach.com
HOSTED_ZONE_NAME=awsteach.com
DB_MIN_CAPACITY=0
DB_MAX_CAPACITY=2
API_RATE_LIMIT=10
API_BURST_LIMIT=20
API_DAILY_QUOTA=5000
WAF_RATE_LIMIT=1000
LOG_RETENTION_DAYS=7
# Class Insights chatbot model (the Gas Ops chat model is chosen by Model Lab / AppConfig)
CHAT_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
ALERT_EMAIL=
SAML_METADATA_URL=
ALLOWED_CIDRS=
# Class Insights companion app (insights/)
INSIGHTS_DOMAIN=demo-insights-dev.awsteach.com
